# Path to the prism-ui repo (relative to this file, or absolute)
PRISM_UI_PATH=../prism-ui

# ---------------------------------------------------------------------------
# PII-at-rest encryption (always on — no user toggle)
# ---------------------------------------------------------------------------
# Dedicated key for encrypting identifier PII columns (phone, name, masked account
# numbers, UPI IDs, raw SMS) so PII ciphertext doesn't share a secret with JWT signing.
# If unset, the app derives the key from SECRET_KEY so dev/test work with no setup.
# Set a distinct strong value in production. Rotating this makes existing PII unreadable.
PII_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Account Aggregator (AA / India Stack) — bank-account auto-detection
# ---------------------------------------------------------------------------
# Provider implementation to use: "setu" (default), "anumati", or "mock".
# If "setu" is selected but no SETU_AA_CLIENT_ID is set and ENVIRONMENT != production,
# the app auto-falls back to "mock" so the consent flow is testable without credentials.
AA_PROVIDER=setu
# Your registered FIU id with the AA (required for production).
AA_FIU_ID=
# Setu FIU API — sandbox defaults shown; swap for live creds in production.
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
# Where the AA hosted-consent page redirects the user back to (app deep link / web bridge).
AA_REDIRECT_URL=http://localhost:5173/aa/callback
# Shared secret used to verify the AA data-ready webhook (HMAC). Optional in sandbox.
AA_WEBHOOK_SECRET=
# Consent validity (days) and how far back to fetch transactions (months).
AA_CONSENT_EXPIRY_DAYS=365
AA_FETCH_FROM_MONTHS=12
# Poll consent status instead of relying on the webhook (default: true outside production).
AA_SANDBOX_MODE=true
